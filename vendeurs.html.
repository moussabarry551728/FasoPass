<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>FasoPass - Scanner QR</title>

<script src="https://unpkg.com/html5-qrcode"></script>

<style>
*{margin:0;padding:0;box-sizing:border-box}
body{font-family:Arial,sans-serif;background:#f4f6f8}
header{
background:linear-gradient(135deg,#00853F,#006B31);
color:white;
padding:22px;
text-align:center;
}
.container{max-width:500px;margin:auto;padding:20px}
.card{
background:white;
padding:20px;
margin-top:20px;
border-radius:18px;
box-shadow:0 8px 20px rgba(0,0,0,.08);
}
button{
width:100%;
padding:14px;
margin-top:10px;
border:none;
border-radius:12px;
background:#00853F;
color:white;
font-size:16px;
font-weight:bold;
}
#reader{
margin-top:15px;
border-radius:12px;
overflow:hidden;
}
#result{
display:none;
margin-top:20px;
padding:15px;
border-radius:12px;
text-align:center;
}
.valide{background:#E8F5E9;color:#00853F}
.invalide{background:#FFEBEE;color:#C62828}
.big{font-size:48px}
</style>
</head>

<body>

<header>
<h1>🏪 FasoPass</h1>
<p>Scanner QR Code</p>
</header>

<div class="container">

<div class="card">

<button onclick="startScanner()">
📷 Ouvrir la caméra
</button>

<div id="reader"></div>

<div id="result"></div>

</div>

</div>

<script>
let scanner;

function startScanner(){

scanner=new Html5Qrcode("reader");

scanner.start(
{ facingMode:"environment" },
{ fps:10, qrbox:250 },
success,
error=>{}
);

}

function success(text){

scanner.stop();

const result=document.getElementById("result");

if(text==="FP-2026-0001"){

result.className="valide";
result.innerHTML=`
<div class="big">✅</div>
<h2>Identité vérifiée</h2>
<p><strong>ID :</strong> ${text}</p>
<p>Compte actif</p>
`;

}else{

result.className="invalide";
result.innerHTML=`
<div class="big">❌</div>
<h2>QR Code inconnu</h2>
<p>${text}</p>
`;

}

result.style.display="block";

}
</script>

</body>
</html>