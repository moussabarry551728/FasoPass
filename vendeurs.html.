<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>FasoPass - Gestion des Vendeurs</title>
<link rel="stylesheet" href="css/style.css">

<style>
body{margin:0;font-family:Arial,sans-serif;background:#f5f7fa;}
.hero{background:linear-gradient(90deg,#0a8f3c,#f4d03f,#d50032);color:white;text-align:center;padding:25px;}
.container{max-width:700px;margin:20px auto;padding:15px;}
.card{background:white;padding:20px;border-radius:18px;box-shadow:0 5px 15px rgba(0,0,0,.15);margin-bottom:20px;}
.btn{width:100%;padding:14px;margin:8px 0;border:none;border-radius:30px;font-size:16px;font-weight:bold;cursor:pointer;}
.green{background:#0a8f3c;color:white;}
.blue{background:#1565c0;color:white;}
.red{background:#d50032;color:white;}
.vendeur-item{display:flex;justify-content:space-between;align-items:center;padding:12px;border-bottom:1px solid #ddd;gap:10px;}
.vendeur-item:last-child{border-bottom:none;}
input{width:100%;padding:12px;margin:8px 0;border:1px solid #ccc;border-radius:10px;font-size:16px;box-sizing:border-box;}
.small-btn{padding:10px 14px;border:none;border-radius:20px;cursor:pointer;}
</style>
</head>

<body>

<header class="hero">
<h1>🏪 Gestion des Vendeurs</h1>
<p>Ajouter, supprimer et gérer les vendeurs.</p>
</header>

<div class="container">

<div class="card">
<h2>Ajouter un vendeur</h2>

<input id="nomVendeur" placeholder="Nom complet">
<input id="emailVendeur" type="email" placeholder="Email">
<input id="telephoneVendeur" placeholder="Téléphone">

<button id="ajouterVendeur" class="btn green">
➕ Ajouter un vendeur
</button>
</div>

<div class="card">
<h2>Liste des vendeurs</h2>

<div id="listeVendeurs">

<div class="vendeur-item">
<div>
<strong>Vendeur Démo</strong><br>
vendeur@fasopass.com
</div>

<button class="small-btn red supprimerVendeur">
Supprimer
</button>
</div>

</div>
</div>

<button id="retourDashboard" class="btn blue">
⬅ Retour au tableau de bord
</button>

</div>

<script>
const liste=document.getElementById("listeVendeurs");

document.getElementById("ajouterVendeur").onclick=()=>{

const nom=document.getElementById("nomVendeur").value.trim();
const email=document.getElementById("emailVendeur").value.trim();
const tel=document.getElementById("telephoneVendeur").value.trim();

if(!nom||!email||!tel){
alert("Remplissez tous les champs.");
return;
}

const bloc=document.createElement("div");
bloc.className="vendeur-item";

bloc.innerHTML=`
<div>
<strong>${nom}</strong><br>
${email}<br>
${tel}
</div>

<button class="small-btn red supprimerVendeur">
Supprimer
</button>
`;

liste.appendChild(bloc);

document.getElementById("nomVendeur").value="";
document.getElementById("emailVendeur").value="";
document.getElementById("telephoneVendeur").value="";
};

document.addEventListener("click",e=>{
if(e.target.classList.contains("supprimerVendeur")){
e.target.parentElement.remove();
}
});

document.getElementById("retourDashboard").onclick=()=>{
window.location.href="admin.html";
};
</script>

</body>
</html>